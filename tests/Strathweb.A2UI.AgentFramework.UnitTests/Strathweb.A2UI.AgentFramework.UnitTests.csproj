<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <RootNamespace>Strathweb.A2UI.AgentFramework.UnitTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Strathweb.A2UI.AgentFramework\Strathweb.A2UI.AgentFramework.csproj" />
    <PackageReference Include="Microsoft.Agents.AI" />
    <PackageReference Include="JsonSchema.Net" />
  </ItemGroup>

  <!-- The fake model and the capturing logger are shared with the integration tests, whose Web SDK
       brings Microsoft.Extensions.Logging in implicitly; this keeps the shared files identical. -->
  <ItemGroup>
    <Compile Include="..\Shared\Agents\*.cs" LinkBase="Shared" />
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

</Project>
